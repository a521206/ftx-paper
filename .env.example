# Standalone ftx-paper runtime paths
FTX_PAPER_HOME=C:\\Users\\%USERNAME%\\AppData\\Local\\ftx-paper
FTX_PAPER_RUNTIME_DIR=C:\\Users\\%USERNAME%\\AppData\\Local\\ftx-paper\\runtime
FTX_PAPER_AUTH_DB=C:\\Users\\%USERNAME%\\AppData\\Local\\ftx-paper\\auth\\auth.sqlite3
FTX_PAPER_CONFIG_PATH=C:\\path\\to\\zerodha.json

# API/UI endpoints
FTX_API_BASE_URL=http://127.0.0.1:8501
FTX_WEB_HOST=127.0.0.1
FTX_WEB_PORT=8501
FTX_UI_PORT=8502
